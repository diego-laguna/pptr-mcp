# Scrape worker image. Runs on AWS Lambda (SQS event source); the same image
# can run under Fargate by overriding the entrypoint (see docs/scrape-execution.md).
FROM node:22-slim AS build
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY tsconfig.json tsconfig.build.json nest-cli.json ./
COPY src ./src
RUN pnpm build
RUN rm -rf node_modules && pnpm install --prod --frozen-lockfile --config.node-linker=hoisted

FROM public.ecr.aws/lambda/nodejs:22
WORKDIR ${LAMBDA_TASK_ROOT}
COPY --from=build /app/package.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
CMD ["dist/scrape/worker/lambda-handler.handler"]
