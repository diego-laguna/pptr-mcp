{
  "name": "pptr-mcp-test",
  "version": "1.0.0",
  "description": "",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "migrate": "node-pg-migrate -m migrations -j sql",
    "migrate:up": "node-pg-migrate up -m migrations -j sql",
    "migrate:down": "node-pg-migrate down -m migrations -j sql",
    "test:int": "vitest run --config ./vitest.config.integration.ts",
    "seed:dev": "SEED_DEV_DATA=true node dist/seed/run-seed.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diego-laguna/pptr-mcp.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "bugs": {
    "url": "https://github.com/diego-laguna/pptr-mcp/issues"
  },
  "homepage": "https://github.com/diego-laguna/pptr-mcp#readme",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.310",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/client-scheduler": "^3.1156.0",
    "@aws-sdk/client-sqs": "^3.1156.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-fastify": "^12.1.2",
    "@sparticuz/chromium": "^153.0.0",
    "css-what": "^8.0.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "puppeteer-core": "^25.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "xpath": "^0.0.35",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.14.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
